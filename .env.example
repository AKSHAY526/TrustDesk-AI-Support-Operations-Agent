# Copy to .env and fill in. .env is gitignored and is never sent to the model.

# ---- AI provider (OpenAI-compatible chat completions endpoint) ----
# Leave LLM_API_KEY empty to run the app on the deterministic stand-in model.
# Any OpenAI-compatible endpoint works; three known-good options:
#
# 1. Hosted (Gemini via its OpenAI compatibility layer)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=20
#
# 2. Local, no account needed (Ollama: `ollama pull llama3.2`)
#    The key is unused by Ollama but must be non-empty, because an empty key
#    selects the offline stand-in. Raise the timeout: CPU inference is slow.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2
# LLM_TIMEOUT_SECONDS=180
#
# 3. OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# ---- Demo auth tokens (one per role) ----
TOKEN_AGENT=demo-agent-token
TOKEN_MANAGER=demo-manager-token
TOKEN_ADMIN=demo-admin-token

# ---- Retrieval ----
# Minimum merged score for a policy section to count as "covering" a ticket.
# Below this the agent asks for detail or escalates instead of answering.
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_TOP_K=4
